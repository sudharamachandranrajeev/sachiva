{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sachiva",
  "version": "0.2.0",
  "identifier": "dev.sachiva.sachiva",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sachiva",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNTE0NkM4MUQzMkVBMEQKUldRTjZqSWR5RVpSSHFleUJySk1PTnA4bmxKT21TdjlCSFoyNDlyTkNwZnk1V05Ja1IvSnV6QVUK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/sudharamachandranrajeev/sachiva/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
